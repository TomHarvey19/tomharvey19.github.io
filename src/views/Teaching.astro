---
import Base from '../layouts/Base.astro';
import { t, useTranslations, type Lang } from '../i18n';
import { profile } from '../data/profile';
import { courses, levelLabel, roleLabel, students, supervision, type Student } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = useTranslations(lang);
const range = (start: number, end?: number | null) =>
  end === undefined ? `${start}` : `${start}–${end ?? tr('cv.present')}`;
const studentDates = (s: Student) => {
  if (s.start === undefined) return s.end !== null ? `${s.end}` : tr('teaching.ongoing');
  if (s.end === null && s.expectedEnd !== undefined) return `${s.start}–${s.expectedEnd}`;
  return range(s.start, s.end);
};
const groups = [
  { title: tr('teaching.current'), list: students.filter((s) => s.end === null) },
  { title: tr('teaching.former'), list: students.filter((s) => s.end !== null) },
].filter((g) => g.list.length > 0);
---

<Base lang={lang} route="teaching" title={tr('nav.teaching')}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">{t(profile.institution, lang)}</p>
      <h1>{tr('nav.teaching')}</h1>
    </div>
  </header>

  <div class="container section">
    <section>
      <h2>{tr('teaching.courses')}</h2>
      <div class="courses">
        {
          courses.map((c) => (
            <article class="card course">
              <p class="code">{c.code}</p>
              <h3>{t(c.name, lang)}</h3>
              <p class="muted">
                {t(c.role, lang)} · {range(c.start, c.end)}
              </p>
              {c.students && (
                <p class="students">
                  ~{c.students} {tr('teaching.students')}
                </p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <h2>{tr('teaching.supervision')}</h2>
      {
        groups.map((g) => (
          <div class="group">
            <h3>{g.title}</h3>
            <ul class="students-list card">
              {g.list.map((s) => (
                <li class="student">
                  <div class="who">
                    <span class="tag">{t(levelLabel[s.level], lang)}</span>
                    <strong>{s.name}</strong>
                  </div>
                  <p class="meta">
                    {t(roleLabel[s.role], lang)} · {studentDates(s)}
                  </p>
                  {s.title && (
                    <p class="thesis">{s.url ? <a href={s.url}>{s.title}</a> : s.title}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="totals muted">
        {tr('teaching.totals')}: {supervision.msc.map((s) => t(s.text, lang)).join('; ')}.
      </p>
    </section>

    <section id="prospective">
      <div class="card cta">
        <h2>{tr('teaching.prospective')}</h2>
        <p>{tr('teaching.prospectiveText')}</p>
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  section + section {
    margin-top: 3.5rem;
  }
  #prospective {
    scroll-margin-top: 5rem;
  }
  .courses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .course h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .course p {
    margin: 0;
    font-size: 0.95rem;
  }
  .code {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 0.4rem !important;
  }
  .students {
    margin-top: 0.75rem !important;
    font-weight: 500;
  }
  .group + .group {
    margin-top: 1.75rem;
  }
  .group h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }
  .students-list {
    list-style: none;
    margin: 0;
    padding-block: 0.25rem;
  }
  .student {
    padding-block: 0.9rem;
  }
  .student + .student {
    border-top: 1px solid var(--border);
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .who .tag {
    min-width: 3.5rem;
    text-align: center;
  }
  .meta,
  .thesis {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
  }
  .meta {
    color: var(--muted);
  }
  .thesis {
    font-style: italic;
  }
  .totals {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }
  .cta {
    background: var(--surface-2);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .cta p {
    max-width: 44rem;
  }
</style>
