---
import Base from '../layouts/Base.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { t, useTranslations, type Lang } from '../i18n';
import { profile } from '../data/profile';
import { themes } from '../data/research';
import { publications } from '../data/publications';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = useTranslations(lang);
---

<Base lang={lang} route="research" title={tr('nav.research')}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">{t(profile.field, lang)}</p>
      <h1>{tr('nav.research')}</h1>
      <p class="lede">{t(profile.intro, lang)}</p>
      <nav class="toc" aria-label={tr('nav.research')}>
        {themes.map((theme, i) => <a href={`#${theme.id}`}><span>0{i + 1}</span>{t(theme.title, lang)}</a>)}
      </nav>
    </div>
  </header>

  {
    themes.map((theme, i) => {
      const related = publications.filter((p) => p.themes.includes(theme.id));
      return (
        <section class="section theme" id={theme.id}>
          <div class="container theme-grid">
            <div class="theme-head">
              <span class="num">0{i + 1}</span>
              <h2>{t(theme.title, lang)}</h2>
            </div>
            <div class="theme-body">
              {theme.body.map((para) => <p>{t(para, lang)}</p>)}
              {related.length > 0 && (
                <details>
                  <summary>
                    {tr('research.related')} <span class="count">{related.length}</span>
                  </summary>
                  <div class="related">
                    {related.map((pub) => <PublicationItem pub={pub} lang={lang} />)}
                  </div>
                </details>
              )}
            </div>
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .toc a {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }
  .toc a:hover {
    border-color: var(--accent);
  }
  .toc span {
    color: var(--accent);
    font-family: var(--font-serif);
  }
  .theme {
    scroll-margin-top: 4rem;
  }
  .theme + .theme {
    border-top: 1px solid var(--border);
  }
  .theme-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
  }
  .theme-head {
    position: sticky;
    top: 6rem;
    align-self: start;
  }
  .num {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .theme-body p {
    font-size: 1.08rem;
  }
  details {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  summary {
    cursor: pointer;
    padding: 1rem 1.25rem;
    font-weight: 600;
    list-style-position: inside;
  }
  .count {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.8rem;
  }
  .related {
    padding: 0 1.25rem 0.5rem;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .theme-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .theme-head {
      position: static;
    }
  }
</style>
