---
import ScreenPlot from './ScreenPlot.astro';
import { t, useTranslations, withBase, type Lang } from '../i18n';
import { gallery } from '../data/gallery';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = useTranslations(lang);
const many = gallery.length > 1;
---

<div class="gallery" data-gallery>
  <div class="track" data-track>
    {
      gallery.map((slide, i) => (
        <div
          class="slide"
          role="group"
          aria-roledescription={tr('gallery.slide')}
          aria-label={tr('gallery.position', { n: i + 1, total: gallery.length })}
        >
          {slide.type === 'screen' ? (
            <ScreenPlot lang={lang} />
          ) : (
            <figure class="photo">
              <figcaption class="title" set:html={t(slide.title, lang)} />
              <img
                src={withBase(`${slide.src}-800.webp`)}
                srcset={`${withBase(`${slide.src}-800.webp`)} 800w, ${withBase(`${slide.src}-1600.webp`)} 1600w`}
                sizes="(max-width: 860px) 100vw, 34rem"
                width={slide.width}
                height={slide.height}
                alt={t(slide.alt, lang)}
                decoding="async"
              />
              <p class="caption">
                <Fragment set:html={t(slide.caption, lang)} />
                {slide.credit && <span class="credit"> {tr('gallery.credit')}: {t(slide.credit, lang)}.</span>}
              </p>
            </figure>
          )}
        </div>
      ))
    }
  </div>

  {
    many && (
      <div class="controls">
        <button type="button" class="arrow" data-prev aria-label={tr('gallery.prev')}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <div class="dots">
          {gallery.map((_, i) => (
            <button
              type="button"
              class="dot"
              data-dot={i}
              aria-label={tr('gallery.show', { n: i + 1 })}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
        <button type="button" class="arrow" data-next aria-label={tr('gallery.next')}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    )
  }
</div>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (slides.length < 2) return;

    const current = () => Math.round(track.scrollLeft / slides[1].offsetLeft);
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft, behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(current() - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(current() + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current() - 1);
      else if (e.key === 'ArrowRight') go(current() + 1);
    });

    let active = 0;
    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        active = current();
        dots.forEach((dot, j) => (j === active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
      });
    });

    // A resize (e.g. rotating a phone) can leave the track between slides; put it back.
    new ResizeObserver(() => track.scrollTo({ left: slides[active].offsetLeft, behavior: 'auto' })).observe(track);
  });
</script>

<style>
  .track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    /* Room for the card shadow, which overflow would otherwise clip. */
    padding: 0.5rem 0.5rem 1.25rem;
    margin: -0.5rem -0.5rem -1.25rem;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    scroll-snap-align: start;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.1rem 0.9rem;
    box-shadow: var(--shadow);
  }
  .photo {
    margin: 0;
  }
  .photo .title {
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .photo .caption {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .arrow:hover {
    border-color: var(--accent);
  }
  .dots {
    display: flex;
    gap: 0.5rem;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition: background-color 0.15s, width 0.15s;
  }
  .dot[aria-current='true'] {
    width: 1.4rem;
    background: var(--accent);
  }
</style>
