---
import { t, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const links = [
  { label: 'E-mail', labelNo: 'E-post', href: `mailto:${profile.email}`, icon: 'mail' },
  { label: 'ORCID', href: profile.links.orcid, icon: 'orcid' },
  { label: 'Google Scholar', href: profile.links.scholar, icon: 'scholar' },
  { label: 'NMBU', href: t(profile.links.nmbu, lang), icon: 'nmbu' },
  { label: 'CIGENE', href: profile.links.cigene, icon: 'cigene' },
];
---

<ul class="links">
  {
    links.map((l) => (
      <li>
        <a href={l.href}>
          {l.icon === 'mail' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          )}
          {l.icon === 'orcid' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zM7.37 18.5H5.4V7.97h1.97V18.5zM6.38 6.5a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm11.9 6.63c0 3.07-2.1 5.37-5.47 5.37H9.1V7.97h3.7c3.37 0 5.48 2.3 5.48 5.16zm-2.02 0c0-2.06-1.3-3.37-3.6-3.37h-1.6v6.94h1.6c2.3 0 3.6-1.43 3.6-3.57z" /></svg>
          )}
          {l.icon === 'scholar' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.84 3.93A8.98 8.98 0 0 1 12 9.94c2.9 0 5.48 1.38 7.16 3.5L24 9.5 12 0z" /></svg>
          )}
          {l.icon === 'nmbu' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6" /></svg>
          )}
          {l.icon === 'cigene' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3c0 6 10 6 10 12s-10 3-10 6M17 3c0 6-10 6-10 12s10 3 10 6M8.5 7h7M8.5 17h7" /></svg>
          )}
          <span>{lang === 'no' && l.labelNo ? l.labelNo : l.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }
  a:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  svg {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }
</style>
